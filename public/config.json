{
  "appName": "PEM Knowledge Base and Check Lists",
  "apiBaseUrl": "https://api.example.com",
  "featureFlags": {
    "enableDarkMode": true,
    "enableNotifications": true,
    "enableAnalytics": false
  },
  "theme": {
    "primaryColor": "#081E32",
    "secondaryColor": "#394B5B",
    "accentColor": "#F6F6F6"
  },
  "pagination": {
    "defaultPageSize": 10,
    "pageSizeOptions": [10, 25, 50, 100]
  },
  "session": {
    "timeout": 30,
    "refreshTokenBeforeExpiry": 5
  }
}
