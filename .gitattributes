# Enforce LF line endings for all text files on checkout.
# This prevents Windows CRLF from sneaking into the repo and causing
# noisy diffs or CI failures on Linux/macOS environments.

* text=auto eol=lf

# Source files — always LF
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf

# Binary files — no line ending conversion
*.woff2 binary
*.png   binary
*.jpg   binary
*.svg   text eol=lf